{
  "name": "mental-empire-studio",
  "//productName": "Electron derives the userData directory from productName, falling back to name. electron-builder.yml's productName only names the exe/installer — it is NOT copied into the asar manifest, so without this key a packaged build resolves userData to %APPDATA%\\mental-empire-studio while the dev build (redirected by app.setName in electron/main.ts) uses %APPDATA%\\Mental Empire Studio. Two profiles, and the user's channels and API keys appear to have been reset. app.setName is also only effective before anything reads app.getPath('userData'), which module-init code can do first; this key does not depend on that ordering.",
  "productName": "Mental Empire Studio",
  "version": "0.1.5",
  "description": "Creator-grade automation studio for faceless YouTube channels",
  "main": "out/main/main.js",
  "author": "Mental Empire",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.video-engine.json",
    "fetch:bin": "node scripts/fetch-binaries.mjs",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.mjs",
    "start": "electron-vite preview",
    "dist": "npm run video-engine:bundle-remotion && electron-vite build && electron-builder",
    "dist:dir": "npm run video-engine:bundle-remotion && electron-vite build && electron-builder --dir",
    "dist:win": "npm run video-engine:bundle-remotion && electron-vite build && electron-builder --win",
    "dist:mac": "npm run video-engine:bundle-remotion && electron-vite build && electron-builder --mac",
    "dist:linux": "npm run video-engine:bundle-remotion && electron-vite build && electron-builder --linux",
    "dev:browser": "vite --config vite.renderer.config.ts --host localhost --port 5173",
    "preview:browser": "vite preview --config vite.renderer.config.ts --outDir out/renderer --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:studio": "node scripts/e2e-studio.mjs",
    "e2e:automation": "node scripts/e2e-automation.mjs",
    "e2e:automation:shots": "node scripts/e2e-automation.mjs --shots",
    "e2e:new-templates": "node scripts/e2e-new-templates.mjs",
    "bench:render": "tsx scripts/bench-render.ts",
    "bench:fixture": "tsx scripts/bench-render-fixture.ts",
    "userdata:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-userdata.ps1",
    "userdata:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-userdata.ps1",
    "userdata:list": "powershell -ExecutionPolicy Bypass -File scripts/restore-userdata.ps1 -List",
    "renders:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-renders.ps1",
    "renders:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-renders.ps1",
    "seed:channels:export": "electron scripts/seed-channels.cjs export",
    "seed:channels:apply": "electron scripts/seed-channels.cjs apply",
    "video-engine:setup": "tsx scripts/video-engine-setup.ts",
    "video-engine:bundle-remotion": "tsx scripts/video-engine-bundle-remotion.ts",
    "video-engine:templates:check": "hyperframes check resources/video-engine/hyperframes-registry",
    "video-engine:smoke": "tsx scripts/video-engine-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/anton": "^5.2.7",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@hyperframes/core": "0.7.84",
    "@hyperframes/producer": "0.7.84",
    "@hyperframes/sdk": "0.7.84",
    "@hyperframes/shader-transitions": "0.7.84",
    "@remotion/bundler": "4.0.502",
    "@remotion/captions": "4.0.502",
    "@remotion/media": "4.0.502",
    "@remotion/player": "4.0.502",
    "@remotion/renderer": "4.0.502",
    "@remotion/transitions": "4.0.502",
    "@remotion/zod-types": "4.0.502",
    "@sentry/electron": "^7.15.0",
    "better-sqlite3": "^11.10.0",
    "culori": "4.0.2",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "gsap": "3.13.0",
    "konva": "^9.3.16",
    "lucide-react": "1.30.0",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "music-metadata": "^11.13.0",
    "onda-engine": "^0.6.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.26.2",
    "remotion": "4.0.502",
    "remotion-bits": "0.2.0",
    "ws": "^8.21.1",
    "zod": "4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@remotion/cli": "4.0.502",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "hyperframes": "0.7.84",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "1.49",
    "pngjs": "^7.0.0",
    "tsx": "4.23.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0",
    "postcss": "8.5.25"
  }
}
