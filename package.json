{
  "name": "mental-empire-studio",
  "version": "0.1.5",
  "description": "Creator-grade automation studio for faceless YouTube channels",
  "main": "out/main/main.js",
  "author": "Mental Empire",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "fetch:bin": "node scripts/fetch-binaries.mjs",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.mjs",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dev:browser": "vite --config vite.renderer.config.ts --host localhost --port 5173",
    "preview:browser": "vite preview --config vite.renderer.config.ts --outDir out/renderer --port 4173",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@sentry/electron": "^7.15.0",
    "better-sqlite3": "^11.10.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "konva": "^9.3.16",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "music-metadata": "^11.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.26.2",
    "ws": "^8.21.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.49",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
